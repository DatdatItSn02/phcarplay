# Sao chép file này thành .env rồi điền thông tin thật. KHÔNG đưa .env lên git.
# Chạy "php bin/doctor.php" để tự kiểm tra cấu hình trước khi mở website cho người dùng.
APP_NAME="PH Car Play"
# Địa chỉ thật của website (dùng trong thư đặt lại mật khẩu), ví dụ https://carplay.tenmien.vn
APP_URL=http://localhost:8000
APP_BASE_PATH=
# true chỉ khi đang phát triển trên máy mình: hiện chi tiết lỗi. Website thật luôn để false.
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Mã bí mật để mã hóa dữ liệu nhạy cảm trong database (khóa YouTube API của người dùng). Bắt buộc nếu dùng YOUTUBE_USER_KEYS.
# Chạy "php bin/doctor.php" để được gợi ý một mã ngẫu nhiên. Giữ bí mật và KHÔNG đổi về sau (đổi thì người dùng phải nhập lại khóa).
APP_KEY=
ENFORCE_LICENSE=false
RESET_TTL_MINUTES=60
# Giai đoạn 14: mã 6 số quên/đổi mật khẩu hết hạn sau bao nhiêu phút
OTP_TTL_MINUTES=10
SINGLE_DEVICE_LOGIN=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carweb
DB_USER=root
DB_PASS=

# Gửi mail: log (ghi ra storage/mail, dùng khi phát triển) | mail | smtp
# Nguồn video: thử lần lượt theo VIDEO_SOURCES (Piped trước, Invidious dự phòng). Mỗi nguồn là danh sách địa chỉ cách nhau
# bằng dấu phẩy, website tự thử lần lượt và tạm bỏ qua địa chỉ hỏng 10 phút.
# Tìm địa chỉ đang chạy được: php bin/video-scan.php (chạy trên chính máy chủ website) rồi dán kết quả vào đây.
VIDEO_SOURCES=piped,invidious,youtube
PIPED_API_URLS=https://pipedapi.kavin.rocks,https://pipedapi.projectsegfau.lt
PIPED_TIMEOUT=6
PIPED_VERIFY_SSL=true
INVIDIOUS_API_URLS=https://invidious.privacyredirect.com,https://vid.priv.au,https://invidious.nerdvpn.de,https://invidious.protokolla.fi
INVIDIOUS_TIMEOUT=8
# YouTube dự phòng (khi Piped và Invidious đều hỏng). Luôn được thử sau cùng.
#  - Tìm kiếm: có YOUTUBE_API_KEY (YouTube Data API v3, miễn phí, khoảng 99 lần tìm/ngày) thì dùng API chính thức;
#    không có khóa thì máy chủ đọc trực tiếp kết quả tìm kiếm của YouTube (YOUTUBE_DIRECT=false để tắt).
#  - Đọc trực tiếp: tối đa YOUTUBE_DIRECT_PER_HOUR lần/giờ cho cả website, lưu đệm YOUTUBE_SEARCH_TTL giây,
#    YouTube báo chặn thì nghỉ YOUTUBE_BLOCK_COOLDOWN giây (để YouTube không chặn IP máy chủ lâu hơn).
#  - Phát: không lấy được luồng trực tiếp thì phát bằng trình phát YouTube (có quảng cáo, không có cửa sổ nổi).
YOUTUBE_API_KEY=
# Người dùng có tài khoản tự nhập khóa YouTube Data API riêng trong Cài đặt (không bắt buộc); có khóa riêng thì tìm kiếm của
# người đó đi thẳng bằng khóa ấy (khoảng 100 lần tìm/ngày/khóa). Khóa chỉ dùng cho chính người đó. Cần APP_KEY.
YOUTUBE_USER_KEYS=true
# Nhắc nhẹ người chưa có khóa riêng khi tìm kiếm phải dùng cách dự phòng hoặc lỗi (tối đa 1 lần/ngày, "Để sau" = 7 ngày).
YOUTUBE_KEY_HINT=true
YOUTUBE_DIRECT=true
YOUTUBE_DIRECT_PER_HOUR=300
YOUTUBE_SEARCH_TTL=1800
YOUTUBE_BLOCK_COOLDOWN=1800
YOUTUBE_EMBED=true
YOUTUBE_REGION=VN
# Video phát khi mở website, CHỈ dùng khi người dùng chưa có bài hay nghe và chưa có bài trong playlist.
# Dán đường dẫn YouTube bất kỳ: https://www.youtube.com/watch?v=..., https://youtu.be/..., /shorts/... hoặc mã 11 ký tự.
DEFAULT_VIDEO_URL=
MUSIC_QUERY="nhạc trẻ hay nhất hiện nay"
# Danh mục bấm nhanh ở Trang chủ: "Nhãn=từ khóa" cách nhau bằng dấu phẩy (bỏ dòng này thì dùng danh sách mặc định)
# HOME_CHIPS="Nhạc Việt=nhạc Việt mới nhất,Bolero=nhạc bolero trữ tình,Lofi=nhạc lofi chill,Podcast=podcast tiếng Việt"

# Website thật cần smtp (hoặc mail); log chỉ ghi thư vào storage/mail, người dùng sẽ không nhận được thư.
MAIL_DRIVER=log
# Giai đoạn 15: chiếu màn hình điện thoại lên màn hình xe (máy chủ chỉ ghép nối, hình đi thẳng giữa hai máy)
CAST_ENABLED=true
CAST_CODE_TTL_SECONDS=300
# Máy chủ STUN giúp hai máy KHÁC mạng tìm đường nối (để trống = chỉ nối khi cùng mạng). Cùng mạng thì không cần.
CAST_STUN_URLS=stun:stun.l.google.com:19302
# Giai đoạn 14: gửi mã qua SMS. Hiện chưa tích hợp nhà mạng: để none (chỉ gửi email). log = ghi vào storage/logs/sms.log để thử.
SMS_DRIVER=none
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="PH Car Play"
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
SMTP_HELO=localhost

# ---- Bảo mật (mặc định đã an toàn, xem docs/DEPLOY.md) ----
# Chạy sau Cloudflare: CLIENT_IP_HEADER=CF-Connecting-IP ; sau Nginx proxy: CLIENT_IP_HEADER=X-Real-IP
# KHÔNG đặt khi không có proxy (người ngoài sẽ tự khai IP giả được).
CLIENT_IP_HEADER=
# Tạm chặn khi gửi thư quên mật khẩu/đăng ký/nhập sai key/gọi API quá nhiều lần
RATE_LIMIT=true
# Tạm chặn 15 phút khi đăng nhập sai nhiều lần. Đang TẮT theo quyết định của dự án (không giới hạn số lần đăng nhập sai)
LOGIN_THROTTLE=false
# Số lần gọi API YouTube tối đa mỗi IP trong 10 phút (0 = không giới hạn)
RATE_LIMIT_YOUTUBE=1200
# Tiêu đề Content-Security-Policy: chỉ tắt (false) khi cần dò lỗi một tính năng bị chặn
CSP_ENABLED=true
# HSTS (giây) khi chạy HTTPS: trình duyệt luôn dùng https. 0 = tắt
HSTS_MAX_AGE=15552000
# Nguồn hls.js (bỏ trống = tự dùng public/assets/vendor/hls.min.js nếu có, không thì CDN cdnjs)
# HLS_JS_URL=https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.5.17/hls.min.js
# HLS_JS_INTEGRITY=sha384-...   (mã SRI của đúng file trên, lấy ở trang cdnjs.com)
